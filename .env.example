# Front-end build configuration. Copy to .env.local for development.
#
# Vite only exposes variables prefixed VITE_ to the browser bundle. Nothing
# secret goes in this file for that exact reason - anything here is readable
# by anyone who opens the deployed page. Database URLs and session secrets
# live in server/.env, which is never bundled.

# Which store the app runs on.
#
#   local   the original offline store - Electron's JSON file, or localStorage
#           in a plain browser. No server needed. This is what `npm run
#           dev:renderer` uses to work on a screen without a database, and
#           what the current offline desktop build ships as.
#
#   server  PostgreSQL behind the API is the source of truth. Requires the
#           server in ./server to be running and migrated.
#
# Defaults to local when unset. The checked-in .env.local sets "server", which
# is what the project is developed against: the app runs on a school server
# that several accounts use at once. The offline "local" build is kept working
# but is no longer the target. See the top of README.md.
VITE_CHAS_BACKEND=local

# Where the API lives. Leave EMPTY when the API is served from the same origin
# as the app - which is the case in development, where vite.config.ts proxies
# /api to localhost:4000, and in any deployment that puts both behind one
# domain.
#
# Set it only when the two are on different origins (an app on Vercel talking
# to an API on Railway, say). The server's CORS_ORIGIN must then name this
# app's origin, or the browser will refuse to send the session cookie.
VITE_API_URL=
