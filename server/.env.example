# --- The database -----------------------------------------------------------
# Local development runs the Postgres in docker-compose.yml at the repo root.
# In production this is whatever the host gives you; every managed provider
# hands out a URL in this shape.
#
# sslmode=require is not optional once this leaves your machine. These are
# minors' health records, and an unencrypted connection puts them on the wire
# in plaintext.
DATABASE_URL="postgresql://chas:chas@localhost:5432/chas?schema=public"

# --- The API ----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Where the browser build is served from. The API sends credentials, so CORS
# cannot be "*" - the browser refuses that combination outright. Comma-separate
# for more than one.
CORS_ORIGIN="http://localhost:5173"

# --- Sessions ---------------------------------------------------------------
# Used to hash session tokens before they are stored, so a database dump does
# not hand the reader a set of live sessions.
#
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# There is no default. The server refuses to start without it rather than
# falling back to a value that would be identical on every deployment.
SESSION_SECRET=""

# How long a sign-in lasts. A school laptop is shared, so this is deliberately
# short enough that an unattended machine stops being signed in.
SESSION_TTL_HOURS=12
