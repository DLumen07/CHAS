{
  "name": "chas",
  "version": "0.7.3",
  "private": true,
  "description": "CHAS — Child Health Assessment System. Offline nutritional status monitoring and print-bridge reporting for Detailen Elementary School, Maria Aurora, Aurora.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,yellow \"vite\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "cross-env CHAS_DEV_SERVER=http://localhost:5173 electron .",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "npm run build && electron .",
    "dist": "npm run build:desktop && electron-builder --win --config electron-builder.config.cjs",
    "dist:samples": "cross-env CHAS_SAMPLES=1 npm run dist",
    "smoke": "electron scripts/smoke-electron.cjs",
    "build:server-app": "cross-env VITE_CHAS_BACKEND=server VITE_API_URL= vite build",
    "start:server-app": "cross-env CHAS_APP_SERVER=http://localhost:4000 electron .",
    "smoke:server": "electron scripts/smoke-server.cjs",
    "build:offline": "cross-env VITE_CHAS_BACKEND=local VITE_API_URL= vite build",
    "build:desktop": "tsc --noEmit && npm run build:server-app && node scripts/build-desktop-server.mjs",
    "start:desktop": "electron .",
    "seed:samples": "cd server && npx tsx sample-learners.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "embedded-postgres": "17.10.0-beta.17",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
